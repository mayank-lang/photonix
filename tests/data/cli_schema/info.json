{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mayank-lang/photonix/schemas/cli/info/1",
  "title": "photonix info --json output, version 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "photonix.cli/info/1"
    },
    "photonix_version": {
      "type": "string"
    },
    "python_version": {
      "type": "string"
    },
    "python_implementation": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "x64_enabled": {
      "type": "boolean"
    },
    "default_real_dtype": {
      "type": "string"
    },
    "device_count": {
      "type": "integer",
      "minimum": 1
    },
    "optional_dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "available",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "klayout_available": {
      "type": "boolean"
    }
  },
  "required": [
    "backend",
    "default_real_dtype",
    "device_count",
    "klayout_available",
    "optional_dependencies",
    "photonix_version",
    "platform",
    "python_implementation",
    "python_version",
    "schema",
    "x64_enabled"
  ],
  "additionalProperties": false
}
