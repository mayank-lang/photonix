{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mayank-lang/photonix/schemas/cli/mode/1",
  "title": "photonix mode --json output, version 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "photonix.cli/mode/1"
    },
    "solver": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "required": [
        "geometry",
        "wl_um",
        "width_um",
        "resolution",
        "margin_um",
        "num_modes"
      ],
      "properties": {
        "geometry": {
          "enum": [
            "rectangular strip",
            "pdk cross-section"
          ]
        },
        "wl_um": {
          "type": "number"
        },
        "width_um": {
          "type": "number"
        },
        "thickness_um": {
          "type": "number"
        },
        "resolution": {
          "type": "integer",
          "minimum": 0
        },
        "margin_um": {
          "type": "number"
        },
        "num_modes": {
          "type": "integer",
          "minimum": 0
        },
        "core": {
          "type": "string"
        },
        "clad": {
          "type": "string"
        },
        "n_core": {
          "type": "number"
        },
        "n_clad": {
          "type": "number"
        },
        "pdk": {
          "type": "string"
        },
        "cross_section": {
          "type": "string"
        },
        "layer": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "n_eff": {
            "type": "number"
          },
          "n_eff_imag": {
            "type": "number"
          },
          "te_fraction": {
            "type": [
              "number",
              "null"
            ]
          },
          "polarization": {
            "enum": [
              "TE-like",
              "TM-like",
              null
            ]
          },
          "guided": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "guided",
          "index",
          "n_eff",
          "n_eff_imag",
          "polarization",
          "te_fraction"
        ],
        "additionalProperties": false
      }
    },
    "convergence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "string"
            },
            "resolutions": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 3
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3
            },
            "extrapolated": {
              "type": [
                "number",
                "string"
              ]
            },
            "observed_order": {
              "type": [
                "number",
                "string"
              ]
            },
            "estimated_absolute_error": {
              "type": [
                "number",
                "string"
              ]
            },
            "grid_convergence_index": {
              "type": [
                "number",
                "string"
              ]
            },
            "asymptotic": {
              "type": "boolean"
            },
            "converged": {
              "type": "boolean"
            },
            "rtol": {
              "type": "number"
            }
          },
          "required": [
            "asymptotic",
            "converged",
            "estimated_absolute_error",
            "extrapolated",
            "grid_convergence_index",
            "observed_order",
            "quantity",
            "resolutions",
            "rtol",
            "values"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "convergence",
    "inputs",
    "modes",
    "schema",
    "solver"
  ],
  "additionalProperties": false
}
